# Copy to .env (never commit .env). Read by overwatch.yaml via ${VAR}.

# AI provider (any OpenAI-compatible endpoint).
# Submission: Meterless Nightshift, the local runtime. Its token is written to <stateDir>/proxy-token.
LLM_BASE_URL=http://127.0.0.1:8088/v1
LLM_API_KEY=
# Nightshift routing mode (meterless/text.deep) or a pinned model id
OVERWATCH_MODEL=meterless/text.deep
# Fast model for the first guess (Nightshift's low-latency route)
OVERWATCH_TRIAGE_MODEL=meterless/text.fast
#
# Development without Nightshift: call NVIDIA directly with a key from build.nvidia.com
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-...
# OVERWATCH_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# OVERWATCH_TRIAGE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Console access token (open the console once with ?token=<this>)
OVERWATCH_TOKEN=

# H-MEM memory service (memory-service/, `npm start`)
MEMORY_URL=http://127.0.0.1:8099

# Overwatch's own database (history + telemetry). `docker compose -f deploy/docker-compose.yml up -d` provides it.
OVERWATCH_STATE_URL=postgresql+psycopg://overwatch:overwatch@localhost:55433/overwatch

# Zetaris data layer (installed from the Zetaris download, see the README quick start).
# These are the defaults of a local Zetaris install; set ZETARIS_JDBC_URL empty to run without it (development only).
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_DRIVER_CLASS=com.zetaris.lightning.jdbc.LightningDriver
# Path to jdbc/ndp-jdbc-driver-<version>-driver.jar from the Zetaris download:
ZETARIS_DRIVER_JAR=
# The account you sign in to Zetaris with, and its password:
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASSWORD=
# Zetaris runs in Docker: what "localhost" means to it. Linux: 172.17.0.1 (the Docker bridge). macOS/Windows: host.docker.internal
ZETARIS_HOST_ALIAS=172.17.0.1

# Optional notifiers
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
